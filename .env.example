# Bu faylni nusxalab .env deb nomlang. .env hech qachon git'ga tushmaydi.

# 3-dars — @BotFather beradi (Telegramda /newbot)
BOT_TOKEN=

# 7-dars — hosting shu portni ochadi, lokalda tegmaysiz
PORT=3000

# 4-dars — Neon'dan bitta URL (postgresql://... ?sslmode=require)
DATABASE_URL=

# 6-dars — aistudio.google.com dan olinadi (bepul). Bo'sh bo'lsa, bot erkin savolga «Bu buyruqni bilmayman» deydi
GEMINI_API_KEY=
